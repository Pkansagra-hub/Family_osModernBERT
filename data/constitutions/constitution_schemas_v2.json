        "obey": -2.0,
        "consequence": -1.0,
        "discipline": -1.0,
        "in this situation": -3.0,
        "you might consider": -2.5,
        "perhaps you could": -2.0
      },
      "generation_params": {
        "temperature": 0.65,
        "repetition_penalty": 1.02,
        "logits_strength": 1.5,
        "top_p": 0.9,
        "top_k": 50
      },
      "prefix_injection": false,
      "prefix_pattern": [0.1, 0.4, -0.05, 0.2, 0.3, 0.2, -0.2, 0.1]
