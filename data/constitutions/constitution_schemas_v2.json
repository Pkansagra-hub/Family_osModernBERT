{
  "_meta": {
    "version": "2.0.0",
    "description": "FamilyOS Constitution Schemas - 3-Layer Architecture",
    "schema": "familyos://constitution/v2",
    "updated_at": "2025-12-19"
  },

  "family_values": {
    "_description": "Layer 1: Static family values set during onboarding",

    "gentle_parenting": {
      "description": "Empathetic, connection-focused parenting emphasizing emotional validation",
      "core_principles": ["empathy_first", "natural_consequences", "connection_over_correction"],
      "positive_tokens": {
        "understand": 2.5,
        "feel": 2.5,
        "connect": 2.5,
        "together": 2.0,
        "help": 2.0,
        "support": 2.0,
        "calm": 1.5,
        "listen": 2.0,
        "validate": 2.5,
        "love": 1.5,
        "safe": 1.5
      },
      "negative_tokens": {
