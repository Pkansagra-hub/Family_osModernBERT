        "just do it": -2.5,
        "in this situation": -2.0
      },
      "generation_params": {
        "temperature": 0.50,
        "repetition_penalty": 1.05,
        "logits_strength": 1.8,
        "top_p": 0.9,
        "top_k": 50
      },
      "prefix_injection": false,
      "prefix_pattern": [0.3, 0.4, 0.3, 0.4, 0.3, 0.4, 0.3, 0.4]
    }
  },

  "individual_prefs": {
    "_description": "Layer 2: Per-actor preferences (examples)",

    "default": {
      "response_length": "moderate",
      "formality": "neutral",
      "needs_validation_first": true,
      "custom_positive_tokens": {},
      "custom_negative_tokens": {}
    },

    "example_dad": {
      "actor_id": "user_dad",
      "response_length": "concise",
      "formality": "casual",
      "needs_validation_first": false,
      "custom_positive_tokens": {
        "straightforward": 0.3,
        "practical": 0.3
      },
      "custom_negative_tokens": {
        "emotional": -0.2
      }
    },

    "example_mom": {
      "actor_id": "user_mom",
      "response_length": "moderate",
      "formality": "warm",
      "needs_validation_first": true,
      "custom_positive_tokens": {
        "nurturing": 0.3,
        "caring": 0.3
      },
      "custom_negative_tokens": {}
    }
  },

  "situational_rules": {
    "_description": "Layer 3: Dynamic rules based on event signals",

    "high_arousal": {
      "condition": "affect_arousal > 0.7",
      "actions": {
        "force_deescalation": true,
        "temperature_adjustment": -0.15,
        "steering_weight_multiplier": 1.3,
        "inject_tokens": {
          "calm": 0.6,
          "breathe": 0.5,
          "pause": 0.4
        }
      }
    },

    "negative_valence": {
      "condition": "affect_valence < -0.3",
      "actions": {
        "inject_empathy_prefix": true,
        "needs_validation_first": true,
        "inject_tokens": {
          "understand": 0.5,
          "feel": 0.5,
          "hard": 0.3
        }
      }
    },

    "crisis_band": {
      "condition": "affect_band == 'CRISIS'",
      "actions": {
        "force_deescalation": true,
        "temperature_adjustment": -0.25,
        "steering_weight_multiplier": 2.0,
        "max_tokens": 50,
        "inject_tokens": {
          "safe": 0.8,
          "help": 0.6,
          "breathe": 0.6
        }
      }
    },

    "public_context": {
      "condition": "social_context == 'public'",
      "actions": {
        "formality": "formal",
        "inject_tokens": {
          "appropriate": 0.3,
          "consider": 0.3
        },
        "remove_tokens": ["private", "personal"]
      }
    },

    "high_novelty": {
      "condition": "novelty_score > 0.8",
      "actions": {
        "steering_weight_multiplier": 0.7,
        "temperature_adjustment": 0.1,
        "allow_creativity": true
      }
    }
  }
}
