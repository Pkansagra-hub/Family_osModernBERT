        "consistent": 2.0,
        "responsible": 2.0
      },
      "negative_tokens": {
        "maybe": -1.5,
        "perhaps": -1.5,
        "might": -1.0,
        "in this situation": -2.5
      },
      "generation_params": {
        "temperature": 0.45,
        "repetition_penalty": 1.10,
        "logits_strength": 2.0,
        "top_p": 0.85,
        "top_k": 40
      },
      "prefix_injection": true,
      "prefix_pattern": [0.8, 0.1, 0.9, -0.3, -0.4, 0.7, 0.2, 0.5]
    },

    "indian_joint_family": {
      "description": "Emphasizes family unity, elder respect, and collective decision-making",
      "core_principles": ["family_unity", "elder_respect", "collective_harmony"],
      "positive_tokens": {
        "family": 3.0,
        "respect": 3.0,
        "elder": 2.5,
        "together": 2.5,
        "home": 2.0,
        "values": 2.5,
        "tradition": 2.0,
        "blessing": 1.5,
        "harmony": 2.0,
        "duty": 1.5
      },
      "negative_tokens": {
        "alone": -1.5,
        "ignore": -2.0,
        "disrespect": -2.5,
        "individual": -1.0,
        "in this situation": -2.5
      },
      "generation_params": {
        "temperature": 0.50,
        "repetition_penalty": 1.05,
        "logits_strength": 2.0,
        "top_p": 0.9,
        "top_k": 50
      },
      "prefix_injection": true,
      "prefix_pattern": [0.3, 0.6, 0.4, 0.2, 0.5, -0.1, 0.3, 0.7]
    },

    "balanced_approach": {
      "description": "Combines warmth with structure, flexibility with consistency",
      "core_principles": ["warmth_and_structure", "flexible_boundaries", "mutual_respect"],
      "positive_tokens": {
        "balance": 2.0,
        "both": 1.5,
        "understand": 2.0,
        "also": 1.5,
        "while": 1.5,
        "and": 1.0,
        "respect": 2.0,
        "fair": 2.0
      },
      "negative_tokens": {
        "always": -1.0,
        "never": -1.0,
        "must": -1.0,
        "in this situation": -2.0
      },
      "generation_params": {
        "temperature": 0.55,
        "repetition_penalty": 1.05,
        "logits_strength": 1.5,
        "top_p": 0.9,
        "top_k": 50
      },
      "prefix_injection": false,
      "prefix_pattern": [0.2, 0.3, 0.2, 0.3, 0.2, 0.3, 0.2, 0.3]
    },

    "authoritative": {
      "description": "High warmth with high expectations, reasoning-based guidance",
      "core_principles": ["high_warmth", "high_expectations", "explain_reasoning"],
      "positive_tokens": {
        "because": 2.0,
        "reason": 2.0,
        "understand": 2.0,
        "expect": 1.5,
