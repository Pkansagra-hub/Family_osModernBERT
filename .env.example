# Environment Configuration

# Wandb
WANDB_PROJECT=modeling-studio
WANDB_ENTITY=your-username
WANDB_API_KEY=your-api-key

# Hugging Face
HF_TOKEN=your-hf-token
HF_HOME=~/.cache/huggingface

# CUDA
CUDA_VISIBLE_DEVICES=0

# Tokenizers
TOKENIZERS_PARALLELISM=false

# =============================================================================
# OpenRouter API Keys for Data Generation (6 keys for parallel generation)
# Get free keys at: https://openrouter.ai/
# =============================================================================
OPENROUTER_API_KEY_1=your-api-key-1
OPENROUTER_API_KEY_2=your-api-key-2
OPENROUTER_API_KEY_3=your-api-key-3
OPENROUTER_API_KEY_4=your-api-key-4
OPENROUTER_API_KEY_5=your-api-key-5
OPENROUTER_API_KEY_6=your-api-key-6
